# Copy to .env for local runs. Never commit .env.

# --- shared ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/socia
# from: pnpm --filter @socia/api cli create-org --name "1st India News"
ORG_ID=
# 32 random bytes, base64: openssl rand -base64 32 (encrypts TOTP seeds and X tokens)
SECRET_KEY=
LOG_LEVEL=info

# --- storage: R2 in production, a local folder in development ---
STORAGE_DIR=./.local/store
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=socia
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- API ---
PORT=4000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
SESSION_HOURS=12
# false only for local development
REQUIRE_TOTP=true

# --- ingest: where stories come from ---
# samvadia: approved stories from Samvadia's database + footage from the FTP folder it names (read only)
# folder / ftp: the older path, Kruti Dev text files from SOURCE_DIR or the FTP share
SOURCE_MODE=samvadia

# samvadia mode. A SELECT-only login; every session is also opened read-only.
SAMVADIA_DATABASE_URL=
# first run only: how far back to take stories
SAMVADIA_BACKFILL_HOURS=24
# a local folder with the FTP's layout, for development; unset it to use FTP_HOST etc. below
# FOOTAGE_DIR=./.local/ftp-dummy
MEDIA_TYPES=jpg,jpeg,png,webp,mp4,mov
MEDIA_MAX_MB=25
# true: copy videos too; false: videos are only recorded on the draft
MEDIA_VIDEO=false
# how often recent stories' footage folders are listed again for late files
MEDIA_RESCAN_SECONDS=60

# folder mode
SOURCE_DIR=./.local/share
# ftp mode, and samvadia mode's footage (paths come from Samvadia, so FTP_ROOT/FTP_DEPTH are ftp mode only)
# FTP_HOST=
# FTP_PORT=21
# FTP_USER=
# FTP_PASSWORD=
# FTP_SECURE=false
# FTP_ROOT=/
FTP_DEPTH=2
FTP_POLL_SECONDS=5

# --- render ---
RENDER_POOL=3

# --- publish: fake posts nothing; api needs the client's X app (OAuth 1.0a user context) ---
X_MODE=fake
X_USERNAME=1stIndiaNews
# X_CONSUMER_KEY=
# X_CONSUMER_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
X_RATE_TOKENS=100
X_RATE_WINDOW_SECONDS=900
# REDIS_URL=redis://localhost:6379

# --- handles cron ---
WIKIDATA_USER_AGENT=Socia/0.1 (handle directory seed; contact: tech@dorefin.ai)
