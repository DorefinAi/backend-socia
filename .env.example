# Copy to .env for local runs. Never commit .env.

# --- shared ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/socia
# from: pnpm --filter @socia/api cli create-org --name "1st India News"
ORG_ID=
# 32 random bytes, base64: openssl rand -base64 32 (encrypts TOTP seeds and X tokens)
SECRET_KEY=
LOG_LEVEL=info

# --- storage: R2 in production, a local folder in development ---
STORAGE_DIR=./.local/store
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=socia
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- API ---
PORT=4000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
SESSION_HOURS=12
# false only for local development
REQUIRE_TOTP=true

# --- ingest: where stories come from ---
# samvadia: approved stories from Samvadia's database + footage from the FTP folder it names (read only)
# folder / ftp: the older path, Kruti Dev text files from SOURCE_DIR or the FTP share
SOURCE_MODE=samvadia

# samvadia mode. A SELECT-only login; every session is also opened read-only.
SAMVADIA_DATABASE_URL=
# first run only: how far back to take stories
SAMVADIA_BACKFILL_HOURS=24
# a local folder with the FTP's layout, for development; unset it to use FTP_HOST etc. below
# FOOTAGE_DIR=./.local/ftp-dummy
MEDIA_TYPES=jpg,jpeg,png,webp,mp4,mov
MEDIA_MAX_MB=25
# true: copy videos too; false: videos are only recorded on the draft
MEDIA_VIDEO=false
# how often recent stories' footage folders are listed again for late files
MEDIA_RESCAN_SECONDS=60

# folder mode
SOURCE_DIR=./.local/share
# ftp mode, and samvadia mode's footage (paths come from Samvadia, so FTP_ROOT/FTP_DEPTH are ftp mode only)
# FTP_HOST=
# FTP_PORT=21
# FTP_USER=
# FTP_PASSWORD=
# FTP_SECURE=false
# FTP_ROOT=/
FTP_DEPTH=2
FTP_POLL_SECONDS=5

# --- render ---
RENDER_POOL=3

# --- publish: fake posts nothing; api needs the client's X app (OAuth 1.0a user context) ---
X_MODE=fake
X_USERNAME=1stIndiaNews
# X_CONSUMER_KEY=
# X_CONSUMER_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
X_RATE_TOKENS=100
X_RATE_WINDOW_SECONDS=900
# REDIS_URL=redis://localhost:6379

# --- Web Scraper (worker role "trends"; the API's live search and pictures use the same sources) ---
# Free public sources only, no keys: Google News RSS (search hi + en, India top stories), Bing News RSS,
# publishers' RSS, PIB, NDMA Sachet alerts, Google Trends "trending now" RSS, Hindi Wikipedia most-read,
# GDELT, Reddit, YouTube channel feeds. One request per source per run (Reddit at most hourly, Wikipedia
# every 6 h, GDELT 6 s apart with back-off); article pages are read once ever for og:image.
# Not built: YouTube Data API (needs a key), X / Instagram (paid).
TRENDS_POLL_SECONDS=900
TRENDS_GOOGLE_NEWS_HI=राजस्थान
TRENDS_GOOGLE_NEWS_EN=Rajasthan
TRENDS_GEO=IN
# GDELT asks for at most one request every 5 s; false skips it
TRENDS_GDELT=true
# "Name|https://feed,Name|https://feed|national"; empty = the built-in list (Dainik Bhaskar, Amar Ujala, TOI Jaipur,
# HT Jaipur, Indian Express Jaipur; national: NDTV India, The Hindu)
TRENDS_RSS_FEEDS=
TRENDS_GOOGLE_NEWS_TOP=true
# Bing News search text; empty turns Bing off
TRENDS_BING_QUERY=Rajasthan
TRENDS_PIB=true
TRENDS_SACHET=true
TRENDS_WIKIPEDIA=true
# subreddit; empty turns Reddit off
TRENDS_REDDIT=rajasthan
# JSON list of YouTube channels ([{ "name", "channelId" }]); default apps/worker/config/youtube-channels.json, read every run
# TRENDS_YOUTUBE_CHANNELS_FILE=
# article pages read per run for og:image, at most
TRENDS_OG_MAX_PER_RUN=30
TRENDS_USER_AGENT=SociaTrends/0.1 (First India newsroom desk; free public feeds only)

# --- handles cron ---
WIKIDATA_USER_AGENT=Socia/0.1 (handle directory seed; contact: tech@dorefin.ai)
