# Going live - PHASE 1: Hindi breaking-news .txt files from the newsroom share -> ready X posts that the
# desk copies and posts by hand ("Copy & Posted"). No X API keys, no Samvadia database in phase 1.
#
# Runs natively (Node on Windows) on an office PC that can open the share: start from your working local
# .env, change the lines in sections 1-3, save as .env.live (gitignored) and run with --env-file=.env.live.
# Never commit a filled-in copy. Never paste real values into chat, tickets or screenshots.
# Values: no quotes, no spaces around "=".

# ============================================================================================
# 1. Everyone
# ============================================================================================

# The one switch. 1 = phase 1 (X API posting, Samvadia, footage and non-X platforms off; Web Scraper on).
# The SAME value on API and worker. Anything other than 1, 2 or empty stops startup.
PHASE=1

# from: pnpm --filter @socia/api cli create-org --name "1st India News"
ORG_ID=
# 32 random bytes, base64 (encrypts TOTP seeds). Generate once and keep it: changing it breaks every
# user's two-step sign-in. node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_KEY=
LOG_LEVEL=info

# Two-step sign-in (TOTP) for every user: each sets up an authenticator app at first login.
# Codes depend on the clock: keep Windows time sync on (Settings > Time > Sync now).
REQUIRE_TOTP=true

# Proxies allowed to set X-Forwarded-For (the IP the sign-in rate limit keys on).
#   Desk browsers reach the API directly on the office LAN (port 8200): false.
#   Behind one reverse proxy / load balancer that is the ONLY way in: 1.
#   Otherwise list the proxies' addresses/CIDRs, comma-separated. Never "true".
TRUST_PROXY=false

# The desk website's origin(s), comma-separated: the address people open the desk on.
CORS_ORIGINS=http://<office-pc-ip>:<desk-port>
# Plain http on the office LAN: false (secure cookies are not sent over http). true once served over HTTPS.
COOKIE_SECURE=false
SESSION_HOURS=12

# Owner console (Sentry) server-to-server key for /owner: at least 32 characters; unset or shorter = /owner is off (404).
# Generate one, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"; same value as SOCIA_OWNER_KEY in Sentry.
OWNER_API_KEY=

# Cards and files are served by the API at /dev-files; this must be the address desk browsers use.
STORAGE_PUBLIC_BASE=http://<office-pc-ip>:8200/dev-files

# "Add card" renders with headless Chromium; 1 page is plenty in phase 1.
RENDER_POOL=1
# Seconds between scans of today's breaking folder.
FTP_POLL_SECONDS=5

# Web Scraper (worker role "trends", ON in phase 1, one instance only). Needs outbound HTTPS to
# news.google.com, www.bing.com, trends.google.com, api.gdeltproject.org, pib.gov.in, sachet.ndma.gov.in,
# wikimedia.org, www.reddit.com, www.youtube.com, the feeds in TRENDS_RSS_FEEDS and the publishers'
# article/image hosts. No keys. Defaults are in .env.example; change only if needed:
# TRENDS_POLL_SECONDS=900
# TRENDS_RSS_FEEDS=Dainik Bhaskar|https://www.bhaskar.com/rss-v1--category-1740.xml,Amar Ujala|https://www.amarujala.com/rss/rajasthan.xml
# TRENDS_GDELT=true
# "Create draft" rewording: rules is the default and the only mode; any other value stops the API.
# REWRITE_MODE=rules

# ============================================================================================
# 2. Database
# ============================================================================================
# Socia's own Postgres 16 (not Samvadia's). Then: pnpm db:migrate
DATABASE_URL=postgresql://socia:<password>@localhost:5432/socia

# ============================================================================================
# 3. The office PC and the share
# ============================================================================================
PORT=8200
STORAGE_DIR=./.local/store
# The breaking share itself, read only. The Windows account running Node must be able to open it in
# Explorer without a login prompt (if Node runs as a service / LocalSystem, the PC's machine account needs
# read access instead). Layout: <MONTH>_<YEAR>\<DD>_<MONTH>_<YEAR>\*.txt
SOURCE_MODE=folder
SOURCE_LAYOUT=breaking
SOURCE_DIR=\\10.1.1.19\controldata\BREAKING_TAZA_NEWS
# Worker roles for phase 1 (or pass them as arguments). Not publish, not Samvadia:
#   node --env-file=.env.live apps/worker/dist/index.js ingest pipeline render maintenance trends
WORKER_ROLES=ingest,pipeline,render,maintenance,trends

# ============================================================================================
# Phase 2 (OFF in phase 1) - keep for later, leave commented while PHASE=1
# ============================================================================================
# With PHASE=1 these are not read: SOURCE_MODE=samvadia stops the worker, and the publish role does not start.
# For phase 2: set PHASE=2, add "publish" to the worker roles, then:
#
# P2-1. Text: the real Samvadia database, through a SELECT-only login (not Samvadia's own app user).
#    On Samvadia's Postgres, as a superuser:
#      CREATE ROLE socia_reader LOGIN PASSWORD '<strong password>';
#      ALTER ROLE socia_reader SET default_transaction_read_only = on;
#      GRANT CONNECT ON DATABASE samvadia TO socia_reader;
#      GRANT USAGE ON SCHEMA public TO socia_reader;
#      GRANT SELECT ON items, stories TO socia_reader;
# SOURCE_MODE=samvadia
# SOURCE_LAYOUT=flat
# SAMVADIA_DATABASE_URL=postgresql://socia_reader:<password>@<samvadia-db-host>:5432/samvadia
#    First live run: the Samvadia cursor starts SAMVADIA_BACKFILL_HOURS back (default 24). To start
#    fresh from "now" instead, set SAMVADIA_BACKFILL_HOURS=0 before the first start.
# SAMVADIA_BACKFILL_HOURS=24
#
# P2-2. Media: the newsroom FTP instead of the local dummy folder. Remove (or comment out) FOOTAGE_DIR.
#    Socia only lists and downloads; ask IT for a read-only FTP account if one exists.
# FOOTAGE_DIR=
# FTP_HOST=<newsroom-ftp-host>
# FTP_PORT=21
# FTP_USER=<read-only ftp user>
# FTP_PASSWORD=<password>
# FTP_SECURE=false
# MEDIA_TYPES=jpg,jpeg,png,webp,mp4,mov
# MEDIA_MAX_MB=25
# MEDIA_VIDEO=false
#
# P2-3. Posting: the client's X app (OAuth 1.0a user context). Check limits against X's current docs first.
# X_MODE=api
# X_USERNAME=1stIndiaNews
# X_CONSUMER_KEY=<...>
# X_CONSUMER_SECRET=<...>
# X_ACCESS_TOKEN=<...>
# X_ACCESS_TOKEN_SECRET=<...>
# X_RATE_TOKENS=100
# X_RATE_WINDOW_SECONDS=900
# REDIS_URL=redis://<host>:6379
