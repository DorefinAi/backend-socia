# Going live: start from your working local .env and change ONLY these lines.
# Copy this to .env.live (gitignored) to fill it in; never commit real values.
# Everything not listed here (PORT, STORAGE_*, SOURCE_MODE=samvadia, MEDIA_*, RENDER_POOL, ...) stays as it is.

# 1. Text: the real Samvadia database, through a SELECT-only login (not Samvadia's own app user).
#    On Samvadia's Postgres, as a superuser:
#      CREATE ROLE socia_reader LOGIN PASSWORD '<strong password>';
#      ALTER ROLE socia_reader SET default_transaction_read_only = on;
#      GRANT CONNECT ON DATABASE samvadia TO socia_reader;
#      GRANT USAGE ON SCHEMA public TO socia_reader;
#      GRANT SELECT ON items, stories TO socia_reader;
SAMVADIA_DATABASE_URL=postgresql://socia_reader:<password>@<samvadia-db-host>:5432/samvadia

# 2. Media: the newsroom FTP instead of the local dummy folder. Remove (or comment out) FOOTAGE_DIR.
#    Socia only lists and downloads; ask IT for a read-only FTP account if one exists.
# FOOTAGE_DIR=
FTP_HOST=<newsroom-ftp-host>
FTP_PORT=21
FTP_USER=<read-only ftp user>
FTP_PASSWORD=<password>
FTP_SECURE=false

# 3. Posting: the client's X app (OAuth 1.0a user context). Check limits against X's current docs first.
X_MODE=api
X_USERNAME=1stIndiaNews
X_CONSUMER_KEY=<...>
X_CONSUMER_SECRET=<...>
X_ACCESS_TOKEN=<...>
X_ACCESS_TOKEN_SECRET=<...>

# 4. Sign-in: two-step sign-in for every user (each sets up an authenticator app on first login).
REQUIRE_TOTP=true

# 5. Proxies in front of the API. Sign-in rate limits key on the client IP, which is read from
#    X-Forwarded-For only for trusted hops. Behind Render (or any one proxy / load balancer): 1.
#    A hop count is only safe when the API cannot be reached except through the proxy (true on Render);
#    otherwise list the proxies' addresses/CIDRs (comma-separated). Never "true".
TRUST_PROXY=1

# 6. Only if the API is served over HTTPS and/or to another browser origin:
# COOKIE_SECURE=true
# CORS_ORIGINS=https://digital.<domain>
# STORAGE_PUBLIC_BASE=https://<api host>/dev-files

# 7. Web Scraper: a worker with WORKER_ROLES=trends (one instance only). It needs outbound HTTPS to
#    news.google.com, www.bing.com, trends.google.com, api.gdeltproject.org, pib.gov.in, sachet.ndma.gov.in,
#    wikimedia.org, www.reddit.com, www.youtube.com, the feeds in TRENDS_RSS_FEEDS and the publishers'
#    article/image hosts (pictures, read once). No keys. Defaults are in .env.example; change only if needed:
# TRENDS_POLL_SECONDS=900
# TRENDS_RSS_FEEDS=Dainik Bhaskar|https://www.bhaskar.com/rss-v1--category-1740.xml,Amar Ujala|https://www.amarujala.com/rss/rajasthan.xml
# TRENDS_GDELT=true
#    "Create draft" rewords the publisher's text (API): REWRITE_MODE=rules is the default and the only mode;
#    a local model ("local-llm") is planned, not built. Any other value stops the API at startup.
# REWRITE_MODE=rules

# 8. First live run: the Samvadia cursor starts SAMVADIA_BACKFILL_HOURS back (default 24). To start
#    fresh from "now" instead, set SAMVADIA_BACKFILL_HOURS=0 before the first start.
