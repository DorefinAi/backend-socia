# X Videos (branch xvideos): copy to .env.xvideos. Runs on the test copy of the database until it is moved over.
DATABASE_URL=postgresql://socia:CHANGE_ME@localhost:5432/socia_phase1_e2e
ORG_ID=
SECRET_KEY=
XVIDEOS_SHARE=\\10.1.1.20\fin_data\EXPORT FOR YOUTUBE
XVIDEOS_CACHE=C:\vartmaan\data\xvideos-cache
# Speech-to-text after the probe (the media service on the GPU): off until it is wanted
XVIDEOS_SPEECH=off
XVIDEOS_MEDIA_URL=http://127.0.0.1:8300
# Shared by the worker and the media service; any long random string
XVIDEOS_MEDIA_KEY=
# Today's day folder is walked every XVIDEOS_SCAN_SECONDS, every day folder of the month every XVIDEOS_MONTH_SCAN_SECONDS;
# the desk's Refresh button walks the open day at once
XVIDEOS_SCAN_SECONDS=30
XVIDEOS_MONTH_SCAN_SECONDS=600
XVIDEOS=true
PORT=8210
# No PHASE here: in phase 1 the desk hides every page but the X desk, and X Clips is its own page
CORS_ORIGINS=http://localhost:3016
COOKIE_SECURE=false
REQUIRE_TOTP=false
LIVE=false
# The api's file storage on this PC (no cloud storage for the test)
STORAGE_DIR=C:/vartmaan/data/xvideos-cache/storage
