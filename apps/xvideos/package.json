{
  "name": "@socia/xvideos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": "./src/api/routes.ts"
  },
  "scripts": {
    "worker": "node --env-file=.env --import tsx src/worker/main.ts",
    "migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "generate": "drizzle-kit generate --name xvideos",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "6.3.0",
    "@socia/db": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "pino": "9.14.0",
    "typebox": "1.4.2"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  }
}
