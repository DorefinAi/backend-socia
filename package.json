{
  "name": "socia-backend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test --concurrency=1",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @socia/db generate",
    "db:migrate": "pnpm --filter @socia/db migrate",
    "local:migrate": "node --env-file=.env --import tsx packages/db/scripts/migrate.ts",
    "local:dev": "node --env-file=.env --import tsx apps/api/scripts/local-dev.ts",
    "local:api": "node --env-file=.env --import tsx apps/api/src/index.ts",
    "local:worker": "node --env-file=.env --import tsx apps/worker/src/index.ts ingest pipeline render publish maintenance trends"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "turbo": "2.11.9",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
